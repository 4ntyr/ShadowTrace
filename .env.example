# ── Required ──────────────────────────────────────────────
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ST_SECRET_KEY=
POSTGRES_PASSWORD=

# ── Server deployment (HTTPS via Caddy) ───────────────────
# Uncomment both lines on the server. ST_DOMAIN's DNS must point at the server.
#COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
#ST_DOMAIN=tracker.example.org

# Allow self-service sign-up. On a private instance set false and create
# accounts with:  docker compose exec api python -m app.cli create-user <email> "<name>"
ST_ALLOW_REGISTRATION=true

# ── Optional live feeds (connectors stay off without them) ──
# AlienVault OTX: free key at https://otx.alienvault.com (Settings → API key)
ST_OTX_API_KEY=
# ACLED: free account at https://acleddata.com (uses your login via OAuth)
ST_ACLED_USERNAME=
ST_ACLED_PASSWORD=

# GDELT is keyless; disable if you only want ACLED
ST_GDELT_ENABLED=true
ST_CORRELATION_WINDOW_DAYS=3

# Local web port (base compose only; bound to 127.0.0.1)
#WEB_PORT=8080
